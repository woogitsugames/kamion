<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>PhysicsRunner.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Sim/Sim.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR 0228 x ADR 0263: the wheel force-feedback model (plain C#, no Unity types) fed by the physics in
         JackknifeForceFeedbackTests. Compiled straight from the Unity project like the physics sources. -->
    <Compile Include="../../../game/Assets/_Project/Input/ForceFeedback.cs;../../../game/Assets/_Project/Input/WheelAxis.cs" LinkBase="Controls" />
  </ItemGroup>

</Project>
