{
  "schema": "kamion.world.materials/1",
  "generator": "art-source/world/materials/_src/build_all.py (pbrkit.py, sets_asphalt.py, sets_other.py)",
  "conventions": {
    "units": "metres; tile_m = world size of one texture repeat",
    "BaseColor": "sRGB, linear albedo calibrated (Rec.709 luminance mean = albedo_target_mean_lum_linear)",
    "Normal": "tangent space, OpenGL (+Y = +v), Unity/glTF convention; import as Normal map",
    "MaskMap": "URP Lit: R metallic, G occlusion, B detail mask, A smoothness; import sRGB off",
    "Var": "R height normalised over height_range_m, G per-element random id (block/slab/chip; point sampled, never averaged), B joint/crack/bare mask (water, dirt, weeds), A convexity/edge wear; import sRGB off, mip filter box",
    "tiers": "High = generated resolution (2048 for square sets), Medium = /2, Low = /4, box-filtered from High in linear space; smoothness per tier gets the normal variance lost by the downsample (Toksvig-style) so distant surfaces do not sparkle",
    "mipmaps": "Unity-generated, Kaiser filter for BaseColor; aniso 4 (Medium) / 8 (High); hf_ratio_albedo = share of albedo variance above half Nyquist (shimmer risk; values in each set entry)",
    "anti_tiling": "(1) macro_variation at 64 m and 264 m rotated (existing shader path); (2) Var.G element id + world tile index hash -> per-element tone jitter (paving, slabs); (3) distinct features (cracks, sealant) only in the 16 m crack layer, faded by macro B; (4) optional second base sample at x2.71 scale on High",
    "albedo_source": "'Cool Pavements' review, arXiv:2409.12242 (https://arxiv.org/abs/2409.12242), p. 7: new asphalt concrete ~0.05, rising with ageing and soiling to ~0.15; Portland cement concrete up to 0.35, soiled ~0.2 within weeks/months. Broadband solar albedo, not visible-band: the texture means are WORKING_VALUE placed inside those ranges",
    "grass_albedo_source": "WORKING_VALUE (visible-band albedo of mown grass; no measured source in repo)"
  },
